# ---------- Neo4j (knowledge graph) ----------
# Local docker (docker compose up -d neo4j): neo4j://localhost:7687, neo4j / password123
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j

# ---------- Cypher execution guard-rails ----------
# Reject any query that is not read-only (checked with EXPLAIN + read transaction)
CYPHER_READ_ONLY=true
# Max rows returned by execute_cypher (extra rows are dropped, result flagged as truncated)
CYPHER_MAX_ROWS=1000
# Max rows sent back to the LLM inside the run_cypher tool
CYPHER_MAX_ROWS_FOR_LLM=50
# Server-side timeout (seconds) for each query
CYPHER_TIMEOUT_SECONDS=30

# ---------- Schema introspection ----------
# Nodes sampled per label by apoc.meta.data (keeps introspection fast on huge graphs)
SCHEMA_SAMPLE_SIZE=1000
# Labels never shown to the agent (semantic layer nodes); comma separated
SCHEMA_EXCLUDED_LABELS=SchemaElement,GlossaryTerm

# ---------- LLM ----------
# 1) OpenAI (default)
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 2) Azure OpenAI / company gateway (used when AZURE_OPENAI_ENDPOINT is set)
# AZURE_OPENAI_ENDPOINT=https://...
# AZURE_OPENAI_API_KEY=...
# OPENAI_API_VERSION=2025-04-01-preview
# OPENAI_CHAT_MODEL=<chat deployment name>
# OPENAI_EMBEDDING_MODEL=<embedding deployment name>

# 3) Local Ollama (used when LOCAL_MODEL=true)
# LOCAL_MODEL=true
# OLLAMA_CHAT_MODEL=devstral-small-2
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Sampling temperature (leave empty for reasoning models such as gpt-5.x) and reasoning effort (low/medium/high)
# LLM_TEMPERATURE=0
LLM_REASONING_EFFORT=low

# ---------- Frontend (local run; in Docker the UI reaches the API by service name) ----------
API_BASE=http://127.0.0.1:8000

# ---------- Docker compose ----------
# Dataset loaded on the first `docker compose up`: small (10k employees, ~30 s) or full (300k, ~3 min)
DATASET_SIZE=full
# Neo4j memory (the defaults fit a 4 GB Docker VM)
# NEO4J_HEAP=1G
# NEO4J_PAGECACHE=1G
# Host ports
# NEO4J_HTTP_PORT=7474
# NEO4J_BOLT_PORT=7687
# API_PORT=8000
# UI_PORT=8501
# Neo4j seen from the api / init containers (set it to use an external database with Docker)
# COMPOSE_NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
# Ollama running on the host, seen from the containers
# OLLAMA_HOST=http://host.docker.internal:11434
